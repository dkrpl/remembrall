#!/bin/sh
# Remembrall Pre-Push Hook
# Verifies zero-drift and schema compliance before pushing to remote repository.

echo "🔮 Running Remembrall pre-push gatekeeper audit..."

if [ -f ".remembrall.md" ]; then
    if command -v node >/dev/null 2>&1 && [ -f "bin/remembrall.js" ]; then
        node bin/remembrall.js gatekeeper
    elif command -v python3 >/dev/null 2>&1; then
        python3 .agents/skills/remembrall/scripts/remembrall.py validate
    fi
    if [ $? -ne 0 ]; then
        echo "❌ Push rejected: Remembrall Gatekeeper audit failed."
        exit 1
    fi
    echo "✅ Remembrall Gatekeeper passed."
fi

exit 0
