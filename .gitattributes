# Auto detect text files and perform LF normalization
* text=auto eol=lf

# GitHub Linguist Language Configuration
*.sh text eol=lf linguist-language=Shell
hooks/pre-commit text eol=lf linguist-language=Shell
hooks/SessionStart text eol=lf linguist-language=Shell
bin/remembrall.js text eol=lf linguist-language=JavaScript
src/remembrall/*.js text eol=lf linguist-language=JavaScript
*.ps1 text eol=crlf linguist-language=PowerShell
*.cmd text eol=crlf linguist-language=Batchfile
*.py text eol=lf linguist-language=Python
